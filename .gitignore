# Local reference thesis/template inspected while preparing the LASA journal
# manuscript.  The publication source lives under paper/lasa_journal_cn/;
# MiKTeX caches and legacy 100 MHz drafts in this directory are not artifacts.
/Master_Thesis_Template/
/tmp/pdfs/

# Local release-staging and publication renders.
/tmp/
/git_history.txt
/output/figures/
/output/pdf/*.pdf

