<mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- States: Row 1 (loading chain) -->
    <mxCell id="idle" value="IDLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="80" y="120" width="120" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="bias" value="Bias Load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="280" y="120" width="120" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="weight" value="Weight Load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="480" y="120" width="120" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="line" value="Line Fill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="680" y="120" width="120" height="50" as="geometry"/>
    </mxCell>

    <!-- States: Row 2 (compute + drain) -->
    <mxCell id="comp" value="Compute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="680" y="320" width="120" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="pdrain" value="PSUM Drain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="480" y="320" width="120" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="fdrain" value="Final Drain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="280" y="320" width="120" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="done" value="DONE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="80" y="320" width="120" height="50" as="geometry"/>
    </mxCell>

    <!-- === EDGES === -->

    <!-- Forward: IDLE -> Bias -> Weight -> Line -> Compute -->
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="idle" target="bias">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e1_label" value="start" style="edgeLabel;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e1">
      <mxGeometry x="-0.1" y="1" relative="1" as="geometry"><mxPoint x="-1" y="-12" as="offset"/></mxGeometry>
    </mxCell>

    <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="bias" target="weight"/>

    <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="weight" target="line"/>

    <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="line" target="comp"/>

    <!-- Compute -> PSUM Drain (non-final K) -->
    <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;exitX=0;exitY=0.5;" edge="1" parent="1" source="comp" target="pdrain">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="640" y="345"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e5_label" value="last K ?" style="edgeLabel;html=1;fontSize=9;fontStyle=2;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e5">
      <mxGeometry x="-0.1" y="1" relative="1" as="geometry"><mxPoint x="-1" y="-10" as="offset"/></mxGeometry>
    </mxCell>

    <!-- Compute -> Final Drain (final K) -->
    <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;exitX=0;exitY=0.5;" edge="1" parent="1" source="comp" target="fdrain">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="640" y="290"/>
          <mxPoint x="340" y="290"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e6_label" value="final K" style="edgeLabel;html=1;fontSize=9;fontStyle=2;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e6">
      <mxGeometry x="-0.1" y="1" relative="1" as="geometry"><mxPoint x="-1" y="-10" as="offset"/></mxGeometry>
    </mxCell>

    <!-- PSUM Drain -> Weight Load (K loop) -->
    <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#0078D7;" edge="1" parent="1" source="pdrain" target="weight">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="400" y="290"/>
          <mxPoint x="400" y="80"/>
          <mxPoint x="540" y="80"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e7_label" value="next K" style="edgeLabel;html=1;fontSize=9;fontStyle=2;fontColor=#0078D7;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e7">
      <mxGeometry x="-0.1" y="1" relative="1" as="geometry"><mxPoint x="-1" y="-10" as="offset"/></mxGeometry>
    </mxCell>

    <!-- Final Drain -> Bias Load (Cout loop) -->
    <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="fdrain" target="bias">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="220" y="290"/>
          <mxPoint x="220" y="80"/>
          <mxPoint x="340" y="80"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e8_label" value="next Cout" style="edgeLabel;html=1;fontSize=9;fontStyle=2;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e8">
      <mxGeometry x="-0.1" y="1" relative="1" as="geometry"><mxPoint x="-1" y="-10" as="offset"/></mxGeometry>
    </mxCell>

    <!-- Final Drain -> DONE -->
    <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="fdrain" target="done"/>
    <mxCell id="e9_label" value="全部完成" style="edgeLabel;html=1;fontSize=9;fontStyle=2;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e9">
      <mxGeometry x="-0.1" y="1" relative="1" as="geometry"><mxPoint x="1" y="-10" as="offset"/></mxGeometry>
    </mxCell>

    <!-- DONE -> IDLE -->
    <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="done" target="idle">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="40" y="345"/>
          <mxPoint x="40" y="80"/>
          <mxPoint x="140" y="80"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e10_label" value="clear" style="edgeLabel;html=1;fontSize=9;fontStyle=2;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e10">
      <mxGeometry x="-0.1" y="1" relative="1" as="geometry"><mxPoint x="-1" y="-10" as="offset"/></mxGeometry>
    </mxCell>

    <!-- Annotations -->
    <mxCell id="start_trigger" value="CTRL.start" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=1;dashed=1;fontSize=10;fontColor=#999999;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="90" y="50" width="90" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="e_trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;endArrow=block;strokeColor=#999999;dashed=1;" edge="1" parent="1" source="start_trigger" target="idle"/>

    <mxCell id="done_flag" value="STATUS.done_sticky" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="75" y="380" width="130" height="16" as="geometry"/>
    </mxCell>

    <!-- Group box for loading states -->
    <mxCell id="load_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=1;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
      <mxGeometry x="260" y="90" width="560" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="load_label" value="服务请求阶段 (Bias / Weight / Line Fill)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#999999;" vertex="1" parent="1">
      <mxGeometry x="390" y="90" width="300" height="20" as="geometry"/>
    </mxCell>

    <!-- Loop annotations -->
    <mxCell id="k_loop_label" value="K 轮次循环" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#0078D7;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="405" y="240" width="80" height="16" as="geometry"/>
    </mxCell>
    <mxCell id="c_loop_label" value="Cout 块循环" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#333333;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="215" y="240" width="80" height="16" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>
