<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Row 1: Input side -->
    <mxCell id="dma_in" value="DDR / DMA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="40" y="60" width="90" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="axis_bw" value="AXI-Stream&lt;br&gt;Bias / Weight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="160" y="60" width="100" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="axis_ifm" value="AXI-Stream&lt;br&gt;IFM Line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="290" y="60" width="100" height="50" as="geometry"/>
    </mxCell>

    <!-- Row 1 continued: Frontend -->
    <mxCell id="lb" value="Line Buffer&lt;br&gt;5-Bank, 3-Line" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="440" y="55" width="110" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="we" value="Window Extract" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="580" y="55" width="100" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="ififo" value="IFM FIFOs&lt;br&gt;(staggered)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="710" y="55" width="100" height="60" as="geometry"/>
    </mxCell>

    <!-- Frontend group box -->
    <mxCell id="frontend_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;strokeWidth=1;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
      <mxGeometry x="425" y="30" width="400" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="frontend_label" value="Frontend" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="600" y="32" width="60" height="20" as="geometry"/>
    </mxCell>

    <!-- Row 2: Systolic Array (downward) -->
    <mxCell id="sa" value="Systolic Array&lt;br&gt;18×16 (576 ops/cycle)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="580" y="180" width="160" height="70" as="geometry"/>
    </mxCell>

    <!-- Weight / Bias on top of SA -->
    <mxCell id="wl" value="Weight Loader" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="600" y="140" width="100" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="bias_buf" value="Bias Buffer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="480" y="140" width="100" height="40" as="geometry"/>
    </mxCell>

    <!-- Row 3: PSUM path -->
    <mxCell id="pfifo" value="PSUM FIFOs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="440" y="300" width="100" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="drain" value="PSUM Drain" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="440" y="390" width="100" height="60" as="geometry"/>
    </mxCell>

    <!-- Ping-Pong -->
    <mxCell id="pp" value="Ping-Pong Buffer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="580" y="390" width="110" height="50" as="geometry"/>
    </mxCell>

    <!-- Row 4: Post-processing -->
    <mxCell id="rq" value="Requant&lt;br&gt;(32-lane)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="440" y="500" width="100" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="act" value="Activation&lt;br&gt;Bypass/ReLU/Leaky" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="570" y="500" width="120" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="wb" value="OFM Writeback&lt;br&gt;(HWC addr)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="720" y="500" width="110" height="60" as="geometry"/>
    </mxCell>

    <!-- Post-processing group box -->
    <mxCell id="post_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;strokeWidth=1;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
      <mxGeometry x="425" y="480" width="420" height="95" as="geometry"/>
    </mxCell>
    <mxCell id="post_label" value="Backend (Requant + Activation + Writeback)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="530" y="482" width="220" height="20" as="geometry"/>
    </mxCell>

    <!-- Row 4 continued: Output -->
    <mxCell id="axis_ofm" value="AXI-Stream&lt;br&gt;OFM Out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="880" y="500" width="100" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="dma_out" value="DDR / DMA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="1010" y="505" width="90" height="50" as="geometry"/>
    </mxCell>

    <!-- === EDGES === -->

    <!-- Row 1 horizontal -->
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="dma_in" target="axis_bw"/>
    <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="axis_bw" target="axis_ifm"/>
    <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="axis_ifm" target="lb"/>
    <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="lb" target="we"/>
    <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="we" target="ififo"/>

    <!-- IFM -> SA -->
    <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="ififo" target="sa"/>

    <!-- Bias/Weight -> SA -->
    <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="axis_bw">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="210" y="140" as="targetPoint"/>
        <Array as="points">
          <mxPoint x="210" y="130"/>
          <mxPoint x="530" y="130"/>
          <mxPoint x="530" y="160"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="wl" target="sa"/>
    <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="bias_buf" target="sa"/>

    <!-- SA -> PSUM path -->
    <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="sa" target="pfifo"/>
    <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="pfifo" target="drain"/>

    <!-- Drain -> Ping-Pong (PSUM feedback) -->
    <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="drain" target="pp"/>

    <!-- Ping-Pong -> SA (feedback loop) -->
    <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="pp">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="580" y="215" as="targetPoint"/>
        <Array as="points">
          <mxPoint x="550" y="415"/>
          <mxPoint x="550" y="250"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Drain -> Requant -->
    <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="drain" target="rq"/>

    <!-- Post-processing chain -->
    <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="rq" target="act"/>
    <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="act" target="wb"/>

    <!-- Output -->
    <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="wb" target="axis_ofm"/>
    <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="axis_ofm" target="dma_out"/>

  </root>
</mxGraphModel>
