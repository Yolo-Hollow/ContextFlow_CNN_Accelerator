<mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Main weight matrix -->
    <mxCell id="wmat" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="180" y="80" width="650" height="450" as="geometry"/>
    </mxCell>
    <mxCell id="w_label" value="权重矩阵 W  (K_total × C_out)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="350" y="85" width="300" height="24" as="geometry"/>
    </mxCell>

    <!-- K axis (vertical) -->
    <mxCell id="k_axis" value="" style="endArrow=classic;html=1;strokeWidth=1.5;" edge="1" parent="1">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="140" y="500" as="sourcePoint"/>
        <mxPoint x="140" y="100" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="k_label" value="K_total" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=1;rotation=90;" vertex="1" parent="1">
      <mxGeometry x="110" y="250" width="60" height="24" as="geometry"/>
    </mxCell>

    <!-- Cout axis (horizontal) -->
    <mxCell id="c_axis" value="" style="endArrow=classic;html=1;strokeWidth=1.5;" edge="1" parent="1">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="180" y="560" as="sourcePoint"/>
        <mxPoint x="830" y="560" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="c_label" value="C_out" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="780" y="562" width="60" height="24" as="geometry"/>
    </mxCell>

    <!-- K-tiling: horizontal bands (blue) -->
    <mxCell id="k_line1" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#0078D7;" edge="1" parent="1">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="180" y="180" as="sourcePoint"/>
        <mxPoint x="830" y="180" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="k_line2" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#0078D7;" edge="1" parent="1">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="180" y="310" as="sourcePoint"/>
        <mxPoint x="830" y="310" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="k_line3" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#0078D7;dashed=1;dashPattern=4 4;" edge="1" parent="1">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="180" y="440" as="sourcePoint"/>
        <mxPoint x="830" y="440" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="k_tile_label" value="K_TILE" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#0078D7;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="140" y="170" width="50" height="16" as="geometry"/>
    </mxCell>

    <!-- Pass labels -->
    <mxCell id="pass0" value="Pass 0" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#0078D7;" vertex="1" parent="1">
      <mxGeometry x="835" y="120" width="50" height="16" as="geometry"/>
    </mxCell>
    <mxCell id="pass1" value="Pass 1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#0078D7;" vertex="1" parent="1">
      <mxGeometry x="835" y="240" width="50" height="16" as="geometry"/>
    </mxCell>
    <mxCell id="pass_more" value="..." style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#0078D7;" vertex="1" parent="1">
      <mxGeometry x="835" y="370" width="30" height="16" as="geometry"/>
    </mxCell>

    <!-- Cout-tiling: vertical lines (red) -->
    <mxCell id="c_line1" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#D83B01;" edge="1" parent="1">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="380" y="80" as="sourcePoint"/>
        <mxPoint x="380" y="530" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="c_line2" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#D83B01;dashed=1;dashPattern=4 4;" edge="1" parent="1">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="580" y="80" as="sourcePoint"/>
        <mxPoint x="580" y="530" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="c_tile_label" value="COUT_TILE" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#D83B01;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="370" y="535" width="80" height="16" as="geometry"/>
    </mxCell>

    <!-- Block labels -->
    <mxCell id="block0" value="Block 0" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#D83B01;" vertex="1" parent="1">
      <mxGeometry x="280" y="58" width="60" height="16" as="geometry"/>
    </mxCell>
    <mxCell id="block1" value="Block 1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#D83B01;" vertex="1" parent="1">
      <mxGeometry x="480" y="58" width="60" height="16" as="geometry"/>
    </mxCell>

    <!-- Highlighted tile -->
    <mxCell id="tile_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#10893E;fillOpacity=15;strokeColor=#10893E;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="180" y="180" width="200" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="tile_label" value="一个 Tile&lt;br&gt;K_TILE × COUT_TILE" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#10893E;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="200" y="215" width="160" height="40" as="geometry"/>
    </mxCell>

    <!-- Spatial tiling annotation -->
    <mxCell id="spatial_label" value="Spatial Tiles" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#10893E;rotation=-90;" vertex="1" parent="1">
      <mxGeometry x="60" y="320" width="80" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="spatial_param" value="(oy_base, ofm_h)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#999999;" vertex="1" parent="1">
      <mxGeometry x="50" y="360" width="90" height="16" as="geometry"/>
    </mxCell>

    <!-- Legend -->
    <mxCell id="legend_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
      <mxGeometry x="180" y="590" width="500" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="leg_k" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#0078D7;" edge="1" parent="1">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="200" y="610" as="sourcePoint"/>
        <mxPoint x="250" y="610" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="leg_k_txt" value="K 分块 (多 Pass 累加)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#0078D7;" vertex="1" parent="1">
      <mxGeometry x="255" y="602" width="130" height="16" as="geometry"/>
    </mxCell>
    <mxCell id="leg_c" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#D83B01;" edge="1" parent="1">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="200" y="630" as="sourcePoint"/>
        <mxPoint x="250" y="630" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="leg_c_txt" value="Cout 分块 (权重替换)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#D83B01;" vertex="1" parent="1">
      <mxGeometry x="255" y="622" width="130" height="16" as="geometry"/>
    </mxCell>
    <mxCell id="leg_s" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#10893E;fillOpacity=15;strokeColor=#10893E;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="400" y="625" width="16" height="16" as="geometry"/>
    </mxCell>
    <mxCell id="leg_s_txt" value="Spatial 分块 (按行切分 OFM)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#10893E;" vertex="1" parent="1">
      <mxGeometry x="420" y="625" width="160" height="16" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>
